# Copie este arquivo para .env e ajuste se quiser. Não commitar o .env
# real se as senhas mudarem para algo que não seja só ambiente local.

POSTGRES_USER=tribo3
POSTGRES_PASSWORD=tribo3_dev
POSTGRES_DB=tribo3
# Porta exposta no SEU computador. Mudamos de 5432 para 5433 porque
# 5432 costuma já estar ocupada por outro Postgres local ou de outro
# projeto. Se 5433 também estiver ocupada na sua máquina, troque aqui.
POSTGRES_HOST_PORT=5433

PGADMIN_EMAIL=dev@tribo3.com
PGADMIN_PASSWORD=tribo3_dev

# Parâmetros do serviço `seed`, que popula o banco no `docker compose up`.
# Mesma SEED = mesmo dataset (§6 do documento de referência).
N_PARTICIPANTES=300
SEED=42
# Vazio = data de hoje. Preencha (AAAA-MM-DD) para reproduzir um lote antigo.
DATA_REFERENCIA=
